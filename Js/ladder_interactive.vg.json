{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "AFL Season Ladder", "fontSize": 16},
    "width": 500,
    "height": 450,
    "data": {
        "url": "Js/data/ladder_multi_year.csv"
    },
    "params": [
        {
            "name": "Year_selection",
            "value": 2025,
            "bind": {
                "input": "select",
                "options": [2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025],
                "labels": ["2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025"],
                "name": "Select Season: "
            }
        }
    ],
    "transform": [
        {"filter": "datum.year == Year_selection"}
    ],
    "mark": {"type": "bar"},
    "encoding": {
        "y": {
            "field": "team",
            "type": "nominal",
            "title": null,
            "sort": "-x"
        },
        "x": {
            "field": "wins",
            "type": "quantitative",
            "title": "Wins"
        },
        "color": {
            "condition": {
                "test": "datum.position <= 8",
                "value": "#1a3a5c"
            },
            "value": "#b0b0b0"
        },
        "tooltip": [
            {"field": "team", "type": "nominal", "title": "Team"},
            {"field": "position", "type": "quantitative", "title": "Position"},
            {"field": "wins", "type": "quantitative", "title": "W"},
            {"field": "losses", "type": "quantitative", "title": "L"},
            {"field": "percentage", "type": "quantitative", "title": "%", "format": ".1f"},
            {"field": "year", "type": "quantitative", "title": "Season", "format": "d"}
        ]
    }
}
